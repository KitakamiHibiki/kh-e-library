# --- Build artifacts ---
# Frontend dist is copied here during build but should not be committed.
# Exception: a stable .gitkeep ensures the dist/ directory exists for go:embed
# on a fresh checkout; the real build output is never committed.
backend/web/dist/*
!backend/web/dist/.gitkeep

